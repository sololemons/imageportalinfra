pipeline {
    agent any

    options {
        timestamps()
        ansiColor('xterm')
    }

    environment {
        REPORT_FILE = "ansible-report.txt"
        ANSIBLE_IMAGE = "willhallonline/ansible:latest"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Provision Infrastructure and apply Kubernetes Manifests') {
            steps {
                script {
                    withCredentials([
                        sshUserPrivateKey(credentialsId: 'ubuntu-ssh-key', keyFileVariable: 'SSH_KEY_PATH')
                    ]) {

                        // 1. Get current Jenkins container ID
                        def containerId = sh(script: 'hostname', returnStdout: true).trim()

                        // 2. Discover actual host path backing /var/jenkins_home
                        def hostJenkinsHome = sh(
                            script: "docker inspect ${containerId} --format '{{range .Mounts}}{{if eq .Destination \"/var/jenkins_home\"}}{{.Source}}{{end}}{{end}}'",
                            returnStdout: true
                        ).trim()

                        // 3. Resolve host workspace path
                        def hostWorkspace = hostJenkinsHome ? "${hostJenkinsHome}/workspace/${JOB_NAME}" : "${WORKSPACE}"

                        echo "Host workspace resolved to: ${hostWorkspace}"

                        // 4. Copy key into workspace root with 600 permissions
                        sh """
                            cp "${SSH_KEY_PATH}" "${WORKSPACE}/id_rsa"
                            chmod 600 "${WORKSPACE}/id_rsa"
                        """

                        try {
                            // 5. Run Ansible clean execution (using passwordless sudo on host)
                            def status = sh(
                                script: """
                                    set -o pipefail

                                    docker run --rm \\
                                        -u 0:0 \\
                                        -v "${hostWorkspace}":/ansible \\
                                        -e ANSIBLE_HOST_KEY_CHECKING=False \\
                                        -w /ansible \\
                                        ${ANSIBLE_IMAGE} \\
                                        ansible-playbook \\
                                            -i ansible/inventory.ini \\
                                            --private-key /ansible/id_rsa \\
                                            ansible/playbook.yml \\
                                        2>&1 | tee "${REPORT_FILE}"
                                """,
                                returnStatus: true
                            )

                            archiveArtifacts(
                                artifacts: REPORT_FILE,
                                fingerprint: true,
                                allowEmptyArchive: false
                            )

                            if (status != 0) {
                                error(
                                    "Infrastructure provisioning failed. " +
                                    "Ansible exit code: ${status}. " +
                                    "See ${REPORT_FILE}"
                                )
                            }

                            echo "Infrastructure provisioning completed successfully."
                        } finally {
                            // 6. Always clean up temporary key from workspace
                            sh "rm -f '${WORKSPACE}/id_rsa'"
                        }
                    }
                }
            }
        }
    }

    post {
        success {
            emailext(
                subject: "Infrastructure Provisioning Successful - Build #${BUILD_NUMBER}",
                body: """
Infrastructure provisioning completed successfully.

Project : ${JOB_NAME}
Build   : #${BUILD_NUMBER}

Build URL:
${BUILD_URL}

The full Ansible execution report is attached.
                """,
                attachmentsPattern: "${REPORT_FILE}",
                to: "solomon@example.com"
            )
        }

        failure {
            emailext(
                subject: "Infrastructure Provisioning Failed - Build #${BUILD_NUMBER}",
                body: """
Infrastructure provisioning failed.

Project : ${JOB_NAME}
Build   : #${BUILD_NUMBER}

Build URL:
${BUILD_URL}

Please review the attached Ansible execution report
to identify and troubleshoot the failing task.
                """,
                attachmentsPattern: "${REPORT_FILE}",
                to: "solomon@example.com"
            )
        }

        always {
            echo "Pipeline execution completed."
        }
    }
}